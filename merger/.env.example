# انسخ هذا الملف إلى .env واملأ القيم — لا تضع قيمًا حقيقية في المستودع
TURSO_DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-with-write-access>

# اختيارية — الافتراضيات بين قوسين
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
PORT=3101
