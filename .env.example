# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية — لا يُرفع لأي مستودع أبدًا

# قاعدة Turso (إلزاميان) — أنشئها: turso db create <name> ثم
#   turso db show <name> --url      → TURSO_DATABASE_URL
#   turso db tokens create <name>   → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-with-write-access>

# خدمة دمج الفيديو — نطاق مشروع merger/ بعد نشره على Vercel
MERGER_API_BASE=https://<your-merger-project>.vercel.app

# اختياري: حماية /mcp بمفتاح Bearer (إن ضُبط يُطلب على كل نداءات /mcp)
MCP_ACCESS_TOKEN=

# اختياري: تجاوز أسماء الموديلات إن غيّرها المزودون
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=

# ── التوكنات التالية للتشغيل المحلي/النشر فقط — لا يقرأها التطبيق على Vercel ──

# مفاتيح مزودي التوليد (تُضبط أيضًا في إعدادات Vercel للمشروع)
KIE_API_KEY=
COMETAPI_KEY=

# دفع GitHub (النشر تلقائي عبر تكامل Git: push → deploy)
GITHUB_TOKEN=

# إعادة نشر/فحص Vercel من السكربتات (اختياري — التكامل التلقائي يغني عنه غالبًا)
VERCEL_TOKEN_1=
